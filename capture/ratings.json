{"success":true,"content":"        <div class=\"row g-4\">\n                            <div class=\"col-md-6 col-lg-4\">\n                    <div class=\"card shadow-sm border-0 h-100\">\n                        <div class=\"card-body\">\n                            <!-- User Icon + Name -->\n                            <div class=\"d-flex align-items-center mb-3\">\n                                <div class=\"avatar rounded-circle text-white d-flex justify-content-center align-items-center me-2\">\n                                    S                                <\/div>\n                                <h6 class=\"mb-0\">Simon<\/h6>\n                            <\/div>\n\n                            <!-- Feedback Text -->\n                            <p class=\"card-text text-dark feedback-text\" style=\"overflow:hidden;\">\n                                Fantastic service, would use again                             <\/p>\n                            <a href=\"javascript:void(0);\" class=\"read-more-link\">Read More<\/a>\n                        <\/div>\n                    <\/div>\n                <\/div>\n                            <div class=\"col-md-6 col-lg-4\">\n                    <div class=\"card shadow-sm border-0 h-100\">\n                        <div class=\"card-body\">\n                            <!-- User Icon + Name -->\n                            <div class=\"d-flex align-items-center mb-3\">\n                                <div class=\"avatar rounded-circle text-white d-flex justify-content-center align-items-center me-2\">\n                                    N                                <\/div>\n                                <h6 class=\"mb-0\">Natasha<\/h6>\n                            <\/div>\n\n                            <!-- Feedback Text -->\n                            <p class=\"card-text text-dark feedback-text\" style=\"overflow:hidden;\">\n                                Very good service. Friendly staff. Got me in the day I wanted which was very convenient.                            <\/p>\n                            <a href=\"javascript:void(0);\" class=\"read-more-link\">Read More<\/a>\n                        <\/div>\n                    <\/div>\n                <\/div>\n                            <div class=\"col-md-6 col-lg-4\">\n                    <div class=\"card shadow-sm border-0 h-100\">\n                        <div class=\"card-body\">\n                            <!-- User Icon + Name -->\n                            <div class=\"d-flex align-items-center mb-3\">\n                                <div class=\"avatar rounded-circle text-white d-flex justify-content-center align-items-center me-2\">\n                                    M                                <\/div>\n                                <h6 class=\"mb-0\">Mr Eric Giles<\/h6>\n                            <\/div>\n\n                            <!-- Feedback Text -->\n                            <p class=\"card-text text-dark feedback-text\" style=\"overflow:hidden;\">\n                                5 Star always excellent service                             <\/p>\n                            <a href=\"javascript:void(0);\" class=\"read-more-link\">Read More<\/a>\n                        <\/div>\n                    <\/div>\n                <\/div>\n                            <div class=\"col-md-6 col-lg-4\">\n                    <div class=\"card shadow-sm border-0 h-100\">\n                        <div class=\"card-body\">\n                            <!-- User Icon + Name -->\n                            <div class=\"d-flex align-items-center mb-3\">\n                                <div class=\"avatar rounded-circle text-white d-flex justify-content-center align-items-center me-2\">\n                                    M                                <\/div>\n                                <h6 class=\"mb-0\">Mr J Davis<\/h6>\n                            <\/div>\n\n                            <!-- Feedback Text -->\n                            <p class=\"card-text text-dark feedback-text\" style=\"overflow:hidden;\">\n                                Very quick and easy. Good value. I will use your services again                             <\/p>\n                            <a href=\"javascript:void(0);\" class=\"read-more-link\">Read More<\/a>\n                        <\/div>\n                    <\/div>\n                <\/div>\n                            <div class=\"col-md-6 col-lg-4\">\n                    <div class=\"card shadow-sm border-0 h-100\">\n                        <div class=\"card-body\">\n                            <!-- User Icon + Name -->\n                            <div class=\"d-flex align-items-center mb-3\">\n                                <div class=\"avatar rounded-circle text-white d-flex justify-content-center align-items-center me-2\">\n                                    M                                <\/div>\n                                <h6 class=\"mb-0\">Mr Coldrick<\/h6>\n                            <\/div>\n\n                            <!-- Feedback Text -->\n                            <p class=\"card-text text-dark feedback-text\" style=\"overflow:hidden;\">\n                                Good service invaluable to me on a Sunday.                            <\/p>\n                            <a href=\"javascript:void(0);\" class=\"read-more-link\">Read More<\/a>\n                        <\/div>\n                    <\/div>\n                <\/div>\n                            <div class=\"col-md-6 col-lg-4\">\n                    <div class=\"card shadow-sm border-0 h-100\">\n                        <div class=\"card-body\">\n                            <!-- User Icon + Name -->\n                            <div class=\"d-flex align-items-center mb-3\">\n                                <div class=\"avatar rounded-circle text-white d-flex justify-content-center align-items-center me-2\">\n                                    M                                <\/div>\n                                <h6 class=\"mb-0\">MRS S SWAN<\/h6>\n                            <\/div>\n\n                            <!-- Feedback Text -->\n                            <p class=\"card-text text-dark feedback-text\" style=\"overflow:hidden;\">\n                                They fit me in at short notice, kept me up to date about what was happening and were friendly and helpful throughout.                            <\/p>\n                            <a href=\"javascript:void(0);\" class=\"read-more-link\">Read More<\/a>\n                        <\/div>\n                    <\/div>\n                <\/div>\n                    <\/div>\n        <!-- https:\/\/kamservicing-devtest.azurewebsites.net\/Images\/trustpilot-logo.png -->\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"review-badges\">\n\n                <!-- <a href=\"https:\/\/www.trustpilot.com\/review\/kamservicing.com\"\n                    target=\"_blank\"\n                    class=\"trustpilot-link badge-card\">\n                    <img\n                    src=\"images\/Trustpilot_logo.png\"\n                    alt=\"Trustpilot Reviews\"\n                    class=\"trustpilot-logo\" style=\"transform: scale(1.2);\"\n                    >\n                <\/a> -->\n\n                <a href=\"javascript:void(0);\" class=\"trustpilot-link badge-card google-badge\">\n\n                    <img src=\"images\/Google_2015_logo.svg.webp\" alt=\"Google Reviews\" class=\"trustpilot-logo\">\n                    <!-- \u2b50 Rating Section -->\n                    <div class=\"google-rating\">\n                        <span class=\"rating-text\">4.6<\/span>\n                        <span class=\"stars\">\n                            <i class=\"fa-solid fa-star\"><\/i>\n                            <i class=\"fa-solid fa-star\"><\/i>\n                            <i class=\"fa-solid fa-star\"><\/i>\n                            <i class=\"fa-solid fa-star\"><\/i>\n                            <i class=\"fa-solid fa-star-half-stroke\"><\/i>\n                        <\/span>\n                    <\/div>\n                <\/a>\n\n                <a href=\"https:\/\/www.goodgaragescheme.com\/pages\/garage.aspx\/6618\/Kam+Servicing+Sherwood\"\n                    target=\"_blank\"\n                    class=\"trustpilot-link badge-card\">\n                    <img\n                    src=\"images\/logo.png\"\n                    alt=\"Good Garage Scheme\"\n                    class=\"trustpilot-logo\"\n                    >\n                <\/a>\n\n                <\/div>\n            <\/div>\n        <\/div>\n\n        <!-- JS for Read More \/ Read Less -->\n        <script>\n        document.querySelectorAll('.read-more-link').forEach(link => {\n            link.addEventListener('click', function() {\n                const p = this.previousElementSibling;\n                if(this.textContent === 'Read More') {\n                    p.style.maxHeight = 'none';\n                    p.style.overflow = 'visible';\n                    this.textContent = 'Read Less';\n                } else {\n                    p.style.maxHeight = '60px'; \/\/ height of truncated text\n                    p.style.overflow = 'hidden';\n                    this.textContent = 'Read More';\n                }\n            });\n        });\n\n        \/\/ Initialize truncated state\n        document.querySelectorAll('.feedback-text').forEach(p => {\n            p.style.maxHeight = '60px';\n            p.style.overflow = 'hidden';\n        });\n        <\/script>\n        "}